{
  "rules": {
    "waiting": {
      ".read": false,
      ".write": false
    },
    "queue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "nick": { ".validate": "newData.isString() && newData.val().length <= 30 && (!newData.val().beginsWith('관리자') || $uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33')" },
        "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "claimedBy": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('queue').child($uid).child('ts').exists()"
        }
      }
    },
    "rate": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "(newData.child('t').exists() || !data.child('t').exists()) && (newData.child('p').exists() || !data.child('p').exists())",
        "t": { ".validate": "newData.val() === now && (!data.exists() || now >= data.val() + 300)" },
        "p": { ".validate": "newData.val() === now && (!data.exists() || now >= data.val() + 2000)" },
        "$other": { ".validate": false }
      }
    },
    "assign": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || (newData.exists() && root.child('rooms').child(newData.child('roomId').val() + '').child('members').child(auth.uid).exists() && root.child('rooms').child(newData.child('roomId').val() + '').child('members').child($uid).exists()))"
      }
    },
    "rooms": {
      ".read": "auth != null && auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33'",
      ".write": "auth != null && auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33'",
      ".indexOn": ["ts"],
      "$rid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && !data.exists() && newData.child('members').child(auth.uid).exists()",
        "members": {
          "$m": {
            ".write": "auth != null && auth.uid === $m && data.exists() && newData.exists()",
            "nick": { ".validate": "newData.isString() && newData.val().length <= 30 && (!newData.val().beginsWith('관리자') || $m === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33')" }
          }
        },
        "closed": {
          ".write": "auth != null && root.child('rooms').child($rid).child('members').child(auth.uid).exists()",
          ".validate": "newData.isBoolean()"
        },
        "ready": {
          "$u": { ".write": "auth != null && auth.uid === $u && root.child('rooms').child($rid).child('members').child(auth.uid).exists()" }
        },
        "typing": {
          "$u": { ".write": "auth != null && auth.uid === $u && root.child('rooms').child($rid).child('members').child(auth.uid).exists()" }
        },
        "loc": {
          "$u": {
            ".write": "auth != null && auth.uid === $u && root.child('rooms').child($rid).child('members').child(auth.uid).exists()",
            ".validate": "newData.child('lat').isNumber() && newData.child('lng').isNumber()"
          }
        },
        "messages": {
          "$mid": {
            ".write": "auth != null && !data.exists() && root.child('rooms').child($rid).child('members').child(auth.uid).exists()",
            ".validate": "newData.child('sender').val() === auth.uid && newData.child('ts').val() === now && ((newData.child('type').val() === 'text' && newData.child('text').isString() && newData.child('text').val().length <= 2000 && newData.parent().parent().parent().parent().child('rate').child(auth.uid).child('t').val() === now) || (newData.child('type').val() === 'photo' && newData.child('content').isString() && newData.child('content').val().beginsWith('data:image/') && newData.child('content').val().length <= 1500000 && newData.parent().parent().parent().parent().child('rate').child(auth.uid).child('p').val() === now))"
          }
        }
      }
    },
    "reports": {
      ".read": "auth != null && auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33'",
      "$rid": {
        ".write": "auth != null && (auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33' || (!data.exists() && newData.child('reporter').val() === auth.uid))"
      },
      ".indexOn": ["ts"]
    },
    "banned": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33'"
      }
    },
    "presence": {
      ".read": "auth != null && auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "config": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33'"
    },
    "scores": {
      ".read": "auth != null",
      "$day": {
        ".indexOn": ["score"],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "$day.matches(/^[0-9]{8}$/) && newData.hasChildren(['nick', 'score', 'ts']) && newData.child('score').isNumber() && newData.child('score').val() >= 1 && newData.child('score').val() <= 500 && (!data.exists() || newData.child('score').val() > data.child('score').val()) && newData.child('ts').val() === now && newData.child('nick').isString() && newData.child('nick').val().length <= 30 && (!newData.child('nick').val().beginsWith('관리자') || $uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33')"
        }
      }
    },
    "stats": {
      ".read": false,
      ".write": "auth != null && auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33'"
    }
  }
}
