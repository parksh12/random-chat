{
  "rules": {
    "waiting": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "assign": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "rooms": {
      ".read": "auth != null && auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33'",
      "$rid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (data.child('members').child(auth.uid).exists() || newData.child('members').child(auth.uid).exists())"
      }
    },
    "reports": {
      ".read": "auth != null && auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33'",
      "$rid": {
        ".write": "auth != null && (!data.exists() || auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33')"
      },
      ".indexOn": ["ts"]
    },
    "banned": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33'"
      }
    },
    "presence": {
      ".read": "auth != null && auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "config": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'xWHVAy6ZEmOTIDsbpVL0xumHMH33'"
    },
    "stats": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
